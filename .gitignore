# Secrets — never commit
.env
.env.*
# قالب بلا أسرار — كل قيمه فارغة، وهو ما يُستنسخ على الخادم.
!deploy/.env.production.example
firebase-credentials.json
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Django
/staticfiles/
/media/
logs/
db.sqlite3

# Celery
celerybeat-schedule*

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
.gstack/

# Committed template; the real infra/live/.env stays ignored by the rule above.
!infra/live/.env.example
