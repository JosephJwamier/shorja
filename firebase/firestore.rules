rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
//
// Chat documents are created/updated only by the Django backend (Admin SDK,
// which bypasses these rules entirely). Clients only ever read chats/{chatId}
// and read+create chats/{chatId}/messages/{messageId} — never write the
// parent chat doc itself.
service cloud.firestore {
  match /databases/{database}/documents {

    function isParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return request.auth != null &&
        (request.auth.uid == chat.buyer_id || request.auth.uid == chat.seller_id);
    }

    match /chats/{chatId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.buyer_id || request.auth.uid == resource.data.seller_id);
      // Only the Admin SDK (Django backend) creates/updates chat docs.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);
        allow create: if isParticipant(chatId) &&
          request.resource.data.sender_id == request.auth.uid;
        // Messages are immutable once written.
        allow update, delete: if false;
      }
    }

    // Mirrors User.fcm_token for the Cloud Function to read via the Admin SDK.
    // Clients never read/write this directly.
    match /users/{uid} {
      allow read, write: if false;
    }
  }
}
