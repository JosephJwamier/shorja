# ===========================================================================
# الشورجة — بيئة الإنتاج. انسخه إلى balla/.env على الخادم واملأ الأسرار.
# لا يُودَع الملف الحقيقي في git إطلاقاً (.gitignore يغطي .env).
# ===========================================================================

# --- Django ---------------------------------------------------------------
DEBUG=False
# ولّد مفتاحاً جديداً، لا تعيد استعمال مفتاح التطوير:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# تجنّب الرمز $ في أي قيمة هنا. docker compose --env-file يفسّر ما بعده
# متغيّراً ويستبدله بفراغ، فتحمل الحاوية كلمة غير التي تراها في الملف —
# وأسوأ ما ينتج عنه أن تختلف كلمة MySQL بين القاعدة وDjango بلا رسالة
# مفهومة. أسرار openssl rand -hex ستعشرية فلا تتأثر.
DJANGO_SECRET_KEY=
# نطاق المشاركة مُدرَج أيضاً: Caddy يوجّه shorjeh.com إلى نفس تطبيق
# Django لصفحات /p/ /s/ /a/ /l/، وDjango يردّ 400 على أي Host لا يعرفه.
# 127.0.0.1 مُدرَج لأن SRS يسأل Django على الحلقة المحلية عند كل نشر وكل
# مشاهدة؛ بحذفه يردّ Django 400 فيرى SRS رفضاً ويمنع البثّ كلّه.
ALLOWED_HOSTS=api.shorjeh.com,shorjeh.com,www.shorjeh.com,127.0.0.1
FRONTEND_URL=https://shorjeh.com

# --- قاعدة البيانات -------------------------------------------------------
# بعد أول تشغيل لـ MySQL شغّل مرة واحدة (إلزامي، وإلا رفض migrate العمل):
#   mysql_tzinfo_to_sql /usr/share/zoneinfo | mysql -u root -p mysql
DB_NAME=balla
DB_USER=balla
DB_PASSWORD=
DB_HOST=db
DB_PORT=3306
# كلمة مرور root لحاوية MySQL (تُستعمل مرة عند الإنشاء)
MYSQL_ROOT_PASSWORD=

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- لوحة الإدارة ---------------------------------------------------------
# مسار غير معروف بدل /admin/. ولّده: python -c "import secrets; print(secrets.token_hex(4)+'/')"
ADMIN_URL_PATH=
# فعّلها True بعد أن يسجّل كل الموظفين أجهزة 2FA على /account/two_factor/setup/
ADMIN_REQUIRE_2FA=False

# --- الريلز: Cloudflare R2 ------------------------------------------------
# R2 > Manage R2 API Tokens > Object Read & Write، مقيّد بهذا الـ bucket وحده
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_STORAGE_BUCKET_NAME=shorjeh-reels
# نطاق مخصّص على الـ bucket — لا تستعمل r2.dev (محدود المعدل، والحارس يرفضه)
REELS_PUBLIC_BASE_URL=https://media.shorjeh.com

# --- الدفع (القاصة) -------------------------------------------------------
ALQASEH_BASE_URL=https://api.alqaseh.com/v1
ALQASEH_CHECKOUT_BASE_URL=https://pay.alqaseh.com
ALQASEH_CLIENT_ID=
ALQASEH_CLIENT_SECRET=
# العنوان العام الذي تعود إليه البوابة — ثابت الآن، لا نفق مؤقت
PAYMENT_PUBLIC_BASE_URL=https://api.shorjeh.com

# --- عمولة المنصّة --------------------------------------------------------
PLATFORM_COMMISSION_PERCENT=3

# --- البث المباشر (سيرفر SRS الخاص) ---------------------------------
# الحزمة وخطوات التشغيل في infra/live/README.md. الأسرار الثلاثة
# الأخيرة يجب أن تطابق ما في infra/live/.env على الصندوق نفسه،
# وإلا رفض السيرفر كل نشر ومشاهدة.
LIVE_MEDIA_PROVIDER=srs
SRS_PUBLIC_BASE_URL=https://live.shorjeh.com
SRS_APP=live

# يغطّي أطول بثّ تسمح به، لا ساعة: المشاهد على HLS يستعمل رمزاً واحداً طول
# مشاهدته، فانقضاؤه في المنتصف شاشةٌ ميّتة بلا إعادة اتصال (التفصيل في
# deploy/README.md تحت «التحقّق من حماية HLS»). والناشر يشارك نفس المهلة
# ولا يحتاجها إلا لحظة بدء النشر — إن أزعج ذلك يوماً فالحلّ مهلةُ مشاهدة
# منفصلة في services/live_media/srs.py لا تقصير هذه.
LIVE_TOKEN_TTL_SECONDS=21600
SRS_HOOK_SECRET=
LIVE_TOKEN_SECRET=

# عنوان هذا الخادم العام. يدخل في مرشّحات ICE حرفياً، فلا يصل مشاهد إلى
# البثّ إن كان خطأً — والمصافحة تنجح مع ذلك، فيظهر العيب كصورة لا تأتي.
PUBLIC_IP=

# SRS وDjango على نفس المضيف، فالخطّافات تمرّ على الحلقة المحلية بلا رحلة
# عامة في مسار كل «شاهد». غيّره فقط إن فُصل البثّ إلى صندوق خاص.
DJANGO_HOOK_BASE=http://127.0.0.1:8000

# من حيث يقرأ Django قائمة HLS الحقيقية ليوقّع روابط مقاطعها. SRS على شبكة
# المضيف وDjango في حاوية، فالعنوان هو host-gateway لا 127.0.0.1. ولا
# توجّهه إلى live.shorjeh.com: ذلك يعيد ‎.m3u8‎ إلى نفس النقطة التي تسأل.
SRS_HLS_ORIGIN=http://host.docker.internal:8080

# التسجيل مطفأ: لا شيء يرفع ملفاته ولا يحذفها بعد، وقرص هذا الخادم هو قرص
# قاعدة البيانات. لا تُشغّله قبل أن يصبح لـon_dvr مكانٌ يرفع إليه.
SRS_DVR=off

# المرحّل. المنفذ 3478 لا 443 على خادم مشترك — السبب في
# infra/live/turnserver.conf، ومعه كيف يُستعاد 443 بعنوان ثانٍ.
TURN_HOST=live.shorjeh.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=

# --- البريد ---------------------------------------------------------------
# مفتاح واحد يوقف كل بريد يخرج من المنصّة: الإشعارات، والحجوزات، والمزادات،
# والمحفظة، وتفعيل البريد، واستعادة كلمة المرور بالبريد. الإشعارات الفورية
# (FCM) لا تتأثّر. اتركه false حتى يُضبط مُرسِل حقيقي أدناه ويُختبر.
EMAIL_NOTIFICATIONS_ENABLED=false

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shorjeh.com

# --- المتجر ---------------------------------------------------------------
# فارغ قبل النشر: صفحات المشاركة تُظهر «قادم قريباً» بدل زرّ يقود إلى 404.
PLAY_STORE_URL=

# --- المراقبة -------------------------------------------------------------
# فارغ = معطّل. من sentry.io > Settings > Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- إعدادات التطبيق ------------------------------------------------------
RESERVATION_EXPIRY_HOURS=48
MINIMUM_DEPOSIT_PERCENTAGE=10
MAXIMUM_DEPOSIT_PERCENTAGE=50
AUCTION_BID_EXTENSION_MINUTES=5
AUCTION_MINIMUM_DURATION_HOURS=24
LIVE_SESSION_MAX_DURATION_HOURS=6

# نطاقات إضافية مسموحة لطلبات المتصفح (بوابة التوصيل مثلاً)
CORS_EXTRA_ORIGINS=https://shorjeh.com
# إلزامي للوحة الإدارة خلف HTTPS
CSRF_TRUSTED_ORIGINS=https://api.shorjeh.com

# ── Wevlix — رمز التحقّق عبر واتساب ──────────────────────────────────────
# سجّل على wevlix.com، اربط حساب Meta Business وواتساب، ثم خذ مفتاح
# المشروع من اللوحة. اتركه فارغاً وتبقى نقاط التوثيق تردّ 503 برسالة
# واضحة بدل أن تنهار.
#
# السعر للعراق: ~17 د.ع لكل رسالة (Firebase كانت $0.23 ≈ 300 د.ع).
WEVLIX_API_KEY=
WEVLIX_BASE_URL=https://api.wevlix.com

# مهلة صلاحية الرمز عندنا بالثواني.
OTP_TTL_SECONDS=600
