# TLS تلقائي من Let's Encrypt — لا شهادات تُجدَّد يدوياً.
# يتطلب أن يشير سجل A لـ api.shorjeh.com إلى IP هذا الخادم قبل أول تشغيل.

api.shorjeh.com {
	encode zstd gzip

	# الوسائط والثابت من القرص مباشرة: urls.py لا يخدمها عند DEBUG=False،
	# وCaddy أسرع من Django لها بمراتب.
	handle_path /media/* {
		root * /srv/media
		file_server
	}
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# كل ما تبقّى إلى daphne — بما فيه WebSocket (يرقّيه Caddy تلقائياً).
	handle {
		reverse_proxy web:8000
	}

	header {
		# HSTS يضيفه Django أيضاً عند DEBUG=False؛ وجوده هنا يغطي
		# الاستجابات التي لا تمر بـ Django (الوسائط والثابت).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}

# البث المباشر. SRS يعمل على شبكة المضيف لا على شبكة compose — مرشّحات
# WebRTC تحمل عنوان المضيف ومنافذه الحقيقية، وNAT الخاص بدوكر كان سيُعلن
# عنواناً لا يصله مشاهد. لذا يُوصل الوكيل عبر host-gateway لا باسم خدمة.
#
# الوسائط نفسها لا تمرّ من هنا أبداً: Caddy يحمل المفاوضة (SDP) على 443،
# ثم تنتقل الصورة مباشرةً على UDP/8000 بين الهاتف وSRS.
live.shorjeh.com {
	encode gzip

	# مفاوضة WHIP (نشر) وWHEP (مشاهدة) — طلب POST واحد لكل منهما.
	#
	# handle لا handle_path: SRS ينشر النقطتين على /rtc/v1/whip/ و/rtc/v1/whep/
	# بالنصّ، وhandle_path يحذف البادئة المطابَقة فيصله /v1/whip/ فيردّ 404
	# على كل نشر وكل مشاهدة. (عكس حالة assetlinks.json في نطاق
	# المشاركة أعلاه، حيث الحذف هو المطلوب.)
	handle /rtc/* {
		reverse_proxy host.docker.internal:1985
	}

	# HLS: الطريق البديل لمن تحجب شبكته WebRTC. بلا no-cache يخدم
	# الوكيل قائمة قديمة فيتجمّد البثّ عند مشاهد بلا رسالة خطأ.
	#
	# ولا خطّاف لـ HLS في SRS: القائمة ومقاطعها ملفات يخدمها بنفسه، فلا
	# يسأل أحدٌ Django عنها. وبدون ما تحت هذا السطر يُكمل من حظره البائع
	# مشاهدته — بل ينقله إليه احتياطُ التطبيق نفسه — ويُخدَم اسم البثّ بعد
	# انتهاء الجلسة ما دام الناشر قائماً.
	#
	# والرمز لا يسافر في ترويسة ولا في كوكي: القائمة تسمّي مقاطعها بأسماء
	# نسبية فلا ينقل المشغّل سلسلة استعلامها إليها، وترويسةُ الطلب لا
	# يكرّرها AVFoundation على طلبات المقاطع بثقة (والمفتاح الذي تُضبط به
	# غير موثَّق أصلاً)، والكوكي يُهمله ExoPlayer جملةً. فيُكتب الرمز في
	# روابط المقاطع نفسها — وهو ما تفعله كل خدمة HLS موقَّعة — ومعنى ذلك
	# أن القائمة تُكتب لا تُخدَم:
	#
	#   ‎.m3u8‎ → Django: يتحقّق من الرمز والسياسة، يقرأ القائمة الحقيقية
	#            من SRS، ويوقّع كل رابط فيها لهذا المشاهد وحده.
	#   ‎.ts‎   → SRS مباشرةً خلف forward_auth، والرمز الموقَّع في استعلامه.
	#
	# والمطابقتان لا تتقاطعان بقصد، فترتيب handle لا يغيّر شيئاً حينها. وما
	# ليس قائمةً ولا مقطعاً يُردّ 404 هنا ولا يصل Django — تسجيلات DVR
	# مثلاً، وهي ملفات البثّ كاملةً.
	handle /live/* {
		header Cache-Control "no-cache"
		header Access-Control-Allow-Origin "*"

		@playlist path *.m3u8
		@segment path *.ts

		handle @playlist {
			# orig_uri لا uri: الأول قبل إعادة الكتابة، وفيه اسم البثّ
			# والرمز اللذان يقرأهما Django.
			rewrite * /api/live/hls-playlist/?secret={$SRS_HOOK_SECRET}
			reverse_proxy web:8000 {
				header_up Host 127.0.0.1
				header_up X-Forwarded-Uri {orig_uri}
			}
		}

		handle @segment {
			# route لا سردٌ مباشر: forward_auth وreverse_proxy في رتبة
			# واحدة من ترتيب Caddy للتوجيهات، وroute هي ما يضمن أن يسبق
			# الأول الثاني.
			route {
				forward_auth web:8000 {
					uri /api/live/hls-auth/?secret={$SRS_HOOK_SECRET}

					# live.shorjeh.com ليس في ALLOWED_HOSTS ولا ينبغي
					# أن يكون — لا شيء من Django يُخدَم على هذا
					# النطاق. ولولا هذا السطر لردّ Django 400 على كل
					# طلب، ويحوّله forward_auth إلى رفضٍ لكل مشاهد؛
					# وهو فشل لا يظهر إلا في سجل الوصول. و127.0.0.1
					# مطلوب هناك أصلاً للخطّافات.
					header_up Host 127.0.0.1
				}
				reverse_proxy host.docker.internal:8080
			}
		}

		handle {
			respond 404
		}
	}

	# إحصاءات للقراءة فقط — لا واجهة SRS كاملة فهي تقطع البثّ بطلب واحد.
	handle /api/v1/streams* {
		reverse_proxy host.docker.internal:1985
	}

	handle {
		respond "live" 200
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /data/live-access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}

# نطاق المشاركة. المسارات /p/ /s/ /a/ /l/ هي ما يولّده
# deep_link_config.dart، وتردّ بصفحة معاينة لمن يفتحها بلا تطبيق.
# بوّابة شركة التوصيل — صفحة ستاتيكية بحتة.
#
# نطاق منفصل لا مسار تحت shorjeh.com: الصفحة تُخزّن رمز JWT في
# localStorage، وهو مُقسَّم بالأصل — فنطاقها الخاصّ يمنع أي سكربت على
# نطاق التسويق من قراءته.
#
# ولا أسرار في الملفّات نفسها: الصلاحية تُفرَض على الخادم
# (DeliveryOrderViewSet._company_account_or_403)، فحساب الشركة لا يلمس
# إلا الطلبات المُسنَدة إليه مهما عرف من روابط.
delivery.shorjeh.com {
	encode zstd gzip

	# لا فهرسة: بوّابة تشغيل لا صفحة عامة.
	header X-Robots-Tag "noindex, nofollow"
	header X-Frame-Options "DENY"
	header X-Content-Type-Options "nosniff"

	root * /srv/delivery
	try_files {path} {path}/ /index.html
	file_server
}

shorjeh.com, www.shorjeh.com {
	encode zstd gzip

	# أندرويد يقرأ هذا الملف للتحقق من App Links. لا بد أن يُخدَم من الجذر
	# بالضبط وبنوع application/json، وإلا فشل autoVerify بصمت.
	#
	# handle_path لا handle: الأول يحذف البادئة المطابَقة، والثاني يبقيها —
	# فـ handle كان يبحث عن /srv/static/wellknown/.well-known/assetlinks.json
	# ويردّ 404 مهما وُضع الملف في مكانه الصحيح.
	handle_path /.well-known/* {
		root * /srv/static/wellknown
		header Content-Type application/json
		file_server
	}

	# صور المنتجات: صفحة المعاينة تشير إليها في og:image، وواتساب يجلبها
	# من هذا النطاق لا من api، فلا بد أن تُخدَم هنا أيضاً.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# صفحات المعاينة من Django. يتعرّف عليها عبر Host، وتردّ بـ Open Graph
	# كاملة ليرسم واتساب وتيليغرام بطاقة بدل رابط أزرق أصمّ.
	handle {
		reverse_proxy web:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
