# Copy to .env on the server and fill in. Never commit .env.

# The box's public IPv4 (Hetzner robot → Server → IPs).
PUBLIC_IP=

# DNS name pointing at PUBLIC_IP, e.g. live.example.com — must resolve
# before the first `docker compose up` so Caddy can get its certificate.
LIVE_DOMAIN=
ACME_EMAIL=

# Where SRS reaches Django for on_publish/on_play authorization, e.g.
# https://api.example.com (no trailing slash). Must be reachable from the box.
DJANGO_HOOK_BASE=

# Shared secrets. Generate each with:  openssl rand -hex 32
# The SAME values go into Django's .env as SRS_HOOK_SECRET / TURN_SECRET.
SRS_HOOK_SECRET=
TURN_SECRET=
