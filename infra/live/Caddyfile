# TLS termination + routing for the live box. Caddy fetches and renews the
# certificate itself (Let's Encrypt) — the only prerequisite is that
# {$LIVE_DOMAIN} resolves to this server before the first start.
{
    email {$ACME_EMAIL}
}

{$LIVE_DOMAIN} {
    encode gzip

    # WebRTC signalling (WHIP publish / WHEP play). SRS answers with the SDP;
    # the media itself then flows directly on udp/tcp 8000, not through Caddy.
    # handle, not handle_path: SRS publishes these at /rtc/v1/whip/ and
    # /rtc/v1/whep/ literally. handle_path strips the matched prefix, so SRS
    # would receive /v1/whip/ and answer 404 to every publish and play.
    handle /rtc/* {
        reverse_proxy 127.0.0.1:1985
    }

    # HLS playlists/segments — fallback playback and the only path a plain
    # video player needs.
    #
    # SRS has no hook for HLS: these are files it serves itself, so nothing
    # ever asked Django about them. Caddy asks instead — forward_auth turns
    # each playlist and segment request into a GET on /api/live/hls-auth/
    # and serves the file only on a 2xx (core/live_hooks.HlsAuthView).
    # Without it a banned viewer keeps watching and a stream name keeps
    # serving after its session has ended.
    #
    # The token does not travel in the URL: a playlist names its segments
    # relatively and no player copies its query string onto them, so a
    # segment would arrive with nothing to verify. The app sends it as the
    # X-Live-Token header instead and the player repeats that on every
    # request, so each viewer is judged on their own credential rather than
    # on an address that CGNAT shares between many of them. Request headers
    # are what forward_auth passes to Django anyway, so there is nothing to
    # configure for it here.
    #
    # route, not bare directives: forward_auth and reverse_proxy sort to
    # the same place in Caddy's directive order, and route is what fixes
    # the first ahead of the second.
    handle /live/* {
        header Cache-Control "no-cache"
        header Access-Control-Allow-Origin "*"

        route {
            forward_auth {$DJANGO_HOOK_BASE} {
                uri /api/live/hls-auth/?secret={$SRS_HOOK_SECRET}

                # Django sits on another box behind its own proxy, which
                # routes by Host — so the Host has to name the API domain,
                # not this one. {upstream_hostport} is DJANGO_HOOK_BASE's
                # own host, which is also what its ALLOWED_HOSTS lists.
                header_up Host {upstream_hostport}
            }
            reverse_proxy 127.0.0.1:8080
        }
    }

    # Read-only stats for the admin/dashboard (never the full SRS API).
    handle /api/v1/streams* {
        reverse_proxy 127.0.0.1:1985
    }
    handle /api/v1/clients* {
        reverse_proxy 127.0.0.1:1985
    }

    # Everything else on this host is nobody's business.
    handle {
        respond "live" 200
    }

    log {
        output file /data/access.log {
            roll_size 50mb
            roll_keep 5
        }
    }
}
